# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/smart_restaurant

# ── Face Recognition ─────────────────────────────────────
